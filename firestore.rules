rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isManager() {
      return getUserRole() == 'manager';
    }

    function isStaff() {
      return getUserRole() == 'staff';
    }

    function isCoordinator() {
      return getUserRole() == 'coordinator';
    }

    function canEditPlaygroups() {
      return isAdmin() || isManager() || isCoordinator() || isStaff();
    }

    // Coordinators have everything a manager has, plus the day trips board and the
    // volunteer roster, so they are general dog editors too.
    function canEditDogs() {
      return isAdmin() || isManager() || isCoordinator();
    }

    function canManageUsers() {
      return isAdmin();
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Signing in is not the same as being let in: an admin approves each account
    // from the Admin page before it can see or touch shelter data. Accounts created
    // before this gate have no `approved` field, so only an explicit false is
    // treated as pending — nobody who already had access loses it.
    function isApproved() {
      return hasProfile() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', true) != false;
    }

    function isValidRole(role) {
      return role == 'admin' || role == 'manager' || role == 'coordinator' ||
        role == 'staff' || role == 'volunteer';
    }

    // Only checked when a write actually changes the role. Approving an account sends
    // the whole document back, so demanding a recognised role on every update would
    // make any doc carrying a legacy or missing role unapprovable rather than fixable.
    function setsValidRole() {
      return request.resource.data.get('role', '') == resource.data.get('role', '') ||
        isValidRole(request.resource.data.get('role', ''));
    }

    function isValidSelfProfilePayload(userId) {
      return isSelf(userId) &&
        request.resource.data.uid == request.auth.uid &&
        (request.auth.token.email == null || request.resource.data.email == request.auth.token.email) &&
        request.resource.data.role == 'volunteer' &&
        request.resource.data.approved == false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isApproved();
      allow create: if (canManageUsers() && isValidRole(request.resource.data.get('role', ''))) ||
        isValidSelfProfilePayload(userId);
      allow update: if (canManageUsers() && setsValidRole() &&
        !(resource.data.role == 'admin' && request.resource.data.role != 'admin')) ||
        (isSelf(userId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('approved', true) == resource.data.get('approved', true));
      allow delete: if canManageUsers();
    }

    match /dogs/{dogId} {
      allow read: if isApproved();
      allow create, update, delete: if canEditDogs();
      // Staff/volunteers log baths and yard time, which stamp denormalized
      // timer fields on the dog doc. Allow updates that touch only those.
      allow update: if isApproved() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastBathDate', 'lastBathBy', 'lastYardDate']);

      match /behavioralNotes/{noteId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }

      match /feedingLogs/{logId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }

      match /bathLogs/{logId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }

      match /yardLogs/{logId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }

      match /stoolLogs/{logId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }

      match /dayTripLogs/{logId} {
        allow read, create: if isApproved();
        allow update, delete: if canEditDogs();
      }
    }

    match /cleaningChecklists/{checklistId} {
      allow read: if isApproved();
      allow write: if canEditDogs();
    }

    match /cleaningCompletions/{completionId} {
      allow read, write: if isApproved();
    }

    // Shift handoff notes (cleaning page + dashboard; also written server-side
    // by the phone inbox pipeline).
    match /shiftHandoffs/{handoffId} {
      allow read, write: if isApproved();
    }

    // Shared event visitor counter (Events tab). Any signed-in user can tally.
    match /eventCounters/{counterId} {
      allow read, write: if isApproved();
    }

    // Finished events archived from the Events tab ("mark event over").
    // Editing or deleting history is dog-editor only.
    match /eventHistory/{eventId} {
      allow read, create: if isApproved();
      allow update, delete: if canEditDogs();
    }

    // What the last ASM sync observed — adoptions, fosters, transfers, arrivals.
    // The sync reconciles Firestore with ASM, so the diff exists exactly once; writing
    // it here is what lets every user see the celebration instead of only the browser
    // that happened to run the sync. Written by dog editors (the only ones who can
    // sync), read by everyone, and never edited after the fact.
    match /syncEvents/{eventId} {
      allow read: if isApproved();
      // Written server-side by /api/asm/sync, where firebase-admin bypasses these rules.
      // No client writes any more, which is what lets a staff member's visit record a
      // sync without granting them dog-edit rights.
      allow write: if false;
    }

    // Cross-sync bookkeeping (last sync time, seen ASM ids). Server-only.
    match /syncState/{key} {
      allow read, write: if false;
    }

    match /playgroupSessions/{sessionId} {
      allow read: if isApproved();
      allow create, update, delete: if canEditPlaygroups();
    }

    // Expected-dog placeholders on the kennels board (dogs not yet in ASM).
    match /kennelPlaceholders/{placeholderId} {
      allow read: if isApproved();
      allow create, update, delete: if canEditDogs();
    }

    // Feeding messages read from Slack, waiting for an admin to accept or dismiss them.
    // Written server-side by the webhook; nothing here reaches a dog's history until an
    // admin approves it on the Admin page.
    match /pendingFeedings/{docId} {
      allow read, update: if canManageUsers();
      allow delete: if canManageUsers();
      // Created only by the webhook, where firebase-admin bypasses these rules.
      allow create: if false;
    }

    // The morning surgery list read from Slack. Written server-side by the poll;
    // accepting it on the Admin page is what stamps surgeryDate on the dogs.
    match /pendingSurgeries/{docId} {
      allow read, update, delete: if canManageUsers();
      allow create: if false;
    }

    // Names that stand for several dogs at once — litters, mostly — so a surgery list
    // saying "all the hat puppies" resolves to the puppies.
    match /dogGroups/{groupId} {
      allow read: if isApproved();
      allow write: if canEditDogs();
    }

    match /pendingPlaygroups/{docId} {
      // Read and mark-processed by dog editors only
      allow read, update: if canEditDogs();
      // Create and delete are server-only (firebase-admin SDK bypasses rules)
      allow create, delete: if false;
    }

    match /volunteers/{volunteerId} {
      allow read: if isApproved();
      allow create, update: if isApproved();
      allow delete: if canEditDogs();
    }

    // Supports collectionGroup('dayTripLogs') queries used by dashboard/day trips pages.
    match /{path=**}/dayTripLogs/{logId} {
      allow read: if isApproved();
    }

    // Supports collectionGroup('feedingLogs') query used by dashboard to check today's feedings.
    match /{path=**}/feedingLogs/{logId} {
      allow read: if isApproved();
    }

    // Supports collectionGroup('bathLogs') query used by bath history backfill.
    match /{path=**}/bathLogs/{logId} {
      allow read: if isApproved();
    }
  }
}
