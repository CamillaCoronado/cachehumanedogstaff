PUBLIC_FIREBASE_API_KEY=your_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id
OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-4.1-mini

# Animal Shelter Manager sync (server-side only, never expose to client)
ASM_URL=https://us.sheltermanager.com
ASM_ACCOUNT=your_account_name
ASM_USER=your_username
ASM_PASS=your_password

# Slack webhook — playgroups channel auto-import
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_PLAYGROUPS_CHANNEL_ID=C0XXXXXXXXX

# Firebase Admin SDK (server-side only — for Slack webhook writes)
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# FIREBASE_ADMIN_PROJECT_ID is read from PUBLIC_FIREBASE_PROJECT_ID above

# Google Sheets — day trips / volunteers / dog colors / stats
# Real (private) spreadsheet: create a Google Cloud service account, enable the
# Sheets API, share the spreadsheet with the service-account email (Viewer),
# then set all three vars. When unset, the app falls back to the public copy.
SHEETS_SPREADSHEET_ID=your_real_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-reader@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
